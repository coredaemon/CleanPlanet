---
import { contacts } from '@/data/contacts';

const metrikaId = contacts.analytics.yandexMetrikaId;
---

<script is:inline define:vars={{ metrikaId }}>
  const CONSENT_KEY = 'cleanplanet_cookie_consent';
  const METRIKA_SRC = 'https://mc.yandex.ru/metrika/tag.js?id=' + metrikaId;

  // Счётчик подключается только после согласия в cookie-баннере (152-ФЗ).
  // Функция идемпотентна: повторный вызов ничего не делает.
  window.cleanPlanetLoadAnalytics = function () {
    if (!metrikaId || window.cleanPlanetAnalyticsAllowed) return;
    window.cleanPlanetAnalyticsAllowed = true;

    (function (m, e, t, r, i, k, a) {
      m[i] =
        m[i] ||
        function () {
          (m[i].a = m[i].a || []).push(arguments);
        };
      m[i].l = 1 * new Date();
      for (let j = 0; j < e.scripts.length; j++) {
        if (e.scripts[j].src === r) return;
      }
      k = e.createElement(t);
      a = e.getElementsByTagName(t)[0];
      k.async = 1;
      k.src = r;
      a.parentNode.insertBefore(k, a);
    })(window, document, 'script', METRIKA_SRC, 'ym');

    window.ym(metrikaId, 'init', {
      ssr: true,
      webvisor: true,
      clickmap: true,
      ecommerce: 'dataLayer',
      referrer: document.referrer,
      url: location.href,
      accurateTrackBounce: true,
      trackLinks: true,
    });
  };

  // Согласие уже дано в прошлый визит — подключаем сразу.
  if (localStorage.getItem(CONSENT_KEY) === 'accepted') window.cleanPlanetLoadAnalytics();

  window.cleanPlanetTrack = function (eventName, payload = {}) {
    if (window.ym && window.cleanPlanetAnalyticsAllowed) {
      window.ym(metrikaId, 'reachGoal', eventName, payload);
    }
  };

  const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  const url = new URL(window.location.href);
  const storedUtm = {};
  utmKeys.forEach((key) => {
    const value = url.searchParams.get(key);
    if (value) storedUtm[key] = value;
  });
  if (Object.keys(storedUtm).length)
    sessionStorage.setItem('cleanplanet_utm', JSON.stringify(storedUtm));

  document.addEventListener('click', (event) => {
    const target = event.target.closest('[data-track]');
    if (target) window.cleanPlanetTrack(target.dataset.track);
  });
</script>
