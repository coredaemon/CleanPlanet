<!--
  Информационное уведомление, а не запрос согласия: аналитика работает сразу,
  посетителя предупреждаем. Кнопка «Ок» просто прячет плашку.
  На мобильных поднято над нижней панелью действий.
-->
<div
  id="cookie-notice"
  class="fixed inset-x-3 bottom-[84px] z-50 hidden items-center gap-3 rounded-medium border border-border bg-white px-3 py-2 shadow-md md:inset-x-auto md:bottom-4 md:right-4 md:max-w-md"
  role="note"
>
  <p class="flex-1 text-xs leading-snug text-muted">
    Мы используем cookie и Яндекс.Метрику. Оставаясь на сайте, вы соглашаетесь с этим —
    <a class="font-semibold text-primary underline" href="/privacy/">подробнее</a>.
  </p>
  <button
    class="shrink-0 rounded-medium bg-primary px-4 py-1.5 text-xs font-semibold text-white transition hover:bg-primary-hover"
    type="button"
    data-cookie-ok>Ок</button
  >
</div>

<script is:inline>
  (function () {
    const KEY = 'cleanplanet_cookie_notice';
    const notice = document.getElementById('cookie-notice');
    if (!notice) return;

    if (!localStorage.getItem(KEY)) {
      notice.classList.remove('hidden');
      notice.classList.add('flex');
    }

    notice.querySelector('[data-cookie-ok]')?.addEventListener('click', () => {
      localStorage.setItem(KEY, 'ok');
      notice.classList.add('hidden');
      notice.classList.remove('flex');
    });
  })();
</script>
